<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CentersBarCode.Views.ExamRecordsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CentersBarCode.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:ExamRecordsViewModel"
    Shell.BackgroundColor="Gray">

    <Grid Padding="10" RowDefinitions="Auto,*">
        <!--  Header  -->
        <StackLayout Grid.Row="0" Padding="10,0">
            <!--  Records count  -->
            <Label
                Margin="0,0,0,20"
                FontSize="16"
                HorizontalOptions="Center"
                Text="{Binding RecordsCount, StringFormat='Total Exam Records: {0}'}" />
        </StackLayout>

        <!--  Exam Records Table  -->
        <Grid Grid.Row="1" IsVisible="{Binding HasRecords}">
            <CollectionView BackgroundColor="Transparent" ItemsSource="{Binding ExamRecords}">
                <CollectionView.Header>
                    <!--  Table Header  -->
                    <Grid Padding="10,5" BackgroundColor="LightGray">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            Text="Student Name"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            Text="Degrees"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            FontAttributes="Bold"
                            Text="Actions"
                            VerticalOptions="Center" />
                    </Grid>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExamRecordDisplay">
                        <Grid Padding="10,8" BackgroundColor="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Add separator line  -->
                            <BoxView
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                BackgroundColor="LightGray"
                                HeightRequest="1"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="Start" />

                            <!--  First Row: Name and Degree  -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,5,0,2"
                                FontSize="16"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                TextColor="Black"
                                Text="{Binding StudentName}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,5,0,2"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="Black"
                                VerticalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} / {1}">
                                        <Binding Path="Degree" />
                                        <Binding Path="TotalDegree" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <!--  Delete Button  -->
                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                Grid.RowSpan="4"
                                BackgroundColor="Red"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExamRecordsViewModel}}, Path=DeleteRecordCommand}"
                                CommandParameter="{Binding .}"
                                Text="Delete"
                                TextColor="White"
                                FontSize="12"
                                HeightRequest="70"
                                WidthRequest="70"
                                CornerRadius="5"
                                VerticalOptions="Center" />

                            <!--  Second Row: Code  -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,2,0,2"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                Text="{Binding StudentCode, StringFormat='Code: {0}'}"
                                TextColor="DarkGray"
                                VerticalOptions="Center" />

                            <!--  Second Row Column 1: Date  -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,2,0,2"
                                FontSize="11"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Date}"
                                TextColor="Gray"
                                VerticalOptions="Center" />

                            <!--  Third Row: Not Have Duties indicator (Red text if true)  -->
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,2,0,2"
                                FontSize="13"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="لم يسلم الواجب"
                                TextColor="Red"
                                IsVisible="{Binding NotHaveDuties}"
                                VerticalOptions="Center" />

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!--  No Records Message  -->
        <StackLayout
            Grid.Row="1"
            HorizontalOptions="CenterAndExpand"
            IsVisible="{Binding HasNoRecords}"
            VerticalOptions="CenterAndExpand">

            <Label
                FontSize="18"
                HorizontalOptions="Center"
                Text="No exam records found"
                TextColor="Gray" />

            <Label
                Margin="0,10,0,0"
                FontSize="14"
                HorizontalOptions="Center"
                Text="Add exam records from the Exam and Duties page!"
                TextColor="Gray" />
        </StackLayout>

        <!--  Loading Indicator  -->
        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="CenterAndExpand"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="CenterAndExpand"
            Color="Blue" />
    </Grid>
</ContentPage>
